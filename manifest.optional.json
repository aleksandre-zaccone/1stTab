{
  "manifest_version": 3,
  "name": "1stTab \u2014 Bookmark Manager",
  "description": "Save, organize and find your Chrome bookmarks with folders, tags, notes and safe import/export.",
  "version": "2.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open 1stTab side panel"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save this page to 1stTab"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "optional_permissions": [
    "identity"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "254305727394-fitpsr3ajbn00k2saat0e3qptr8t016f.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "manager.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
