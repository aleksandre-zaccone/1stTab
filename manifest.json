{
  "manifest_version": 3,
  "name": "1stTab",
  "description": "1stTab — new-tab dashboard with bookmarks, world clocks, weather, and retro arcade + Material Design themes.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["manager.html", "privacy.html"],
      "matches": ["chrome-extension://*/*"]
    }
  ]
}
