{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "description": "__MSG_m_save_organize_and_find_your_chrome_bookmarks_with_folders_tags_notes_and_safe_import_export__",
  "version": "2.2.2",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "activeTab",
    "favicon"
  ],
  "optional_permissions": [
    "identity"
  ],
  "optional_host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "254305727394-k6qef9ig6i5mfpbahlcn0go3895ulo0a.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_m_open_1sttab_side_panel__"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_m_save_this_page_to_1sttab__"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "chrome_url_overrides": {
    "newtab": "manager.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
