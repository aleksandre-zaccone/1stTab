{
  "manifest_version": 3,
  "name": "1stTab",
  "description": "1stTab — new-tab dashboard with bookmarks, world clocks, weather, and retro arcade + Material Design themes.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.google.com/s2/favicons*",
    "https://www.googleapis.com/*",
    "https://us-central1-1sttab.cloudfunctions.net/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "permissions": [
    "storage",
    "bookmarks",
    "sidePanel",
    "identity",
    "alarms",
    "tabs",
    "sessions",
    "tabGroups",
    "system.cpu",
    "system.memory",
    "system.storage",
    "history",
    "favicon"
  ],
  "oauth2": {
    "client_id": "254305727394-fitpsr3ajbn00k2saat0e3qptr8t016f.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open 1stTab side panel"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["manager.html", "privacy.html", "terms.html", "settings.html"],
      "matches": ["chrome-extension://*/*"]
    }
  ]
}
