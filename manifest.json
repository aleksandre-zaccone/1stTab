{
  "manifest_version": 3,
  "name": "1stTab",
  "description": "1stTab — new-tab dashboard with bookmarks, world clocks, weather, and retro arcade + Material Design themes.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.google.com/s2/favicons*"
  ],
  "permissions": [
    "storage",
    "bookmarks",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["manager.html", "privacy.html", "settings.html"],
      "matches": ["chrome-extension://*/*"]
    }
  ]
}
